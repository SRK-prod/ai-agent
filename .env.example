# Copy to .env and fill in. Never commit the real .env file.

# --- LLM backend ---
# llm.backend in configs/settings.yaml controls which of these is used.
# Default backend is "api" (direct Anthropic Messages API, model claude-haiku-4-5-20251001).
# Get a key at console.anthropic.com > Settings > API Keys (separate from a Claude Pro/Max
# subscription). Only needed if llm.backend stays "api" -- switch to "cli" to use your
# Claude Pro/Max subscription via the Claude Code CLI instead (slower, no API billing).
ANTHROPIC_API_KEY=

# --- Embeddings ---
# Local sentence-transformers model (configs/settings.yaml knowledge.embedding_model) --
# no API key needed, runs on-device.

# --- Speaker diarization / embedding models (pyannote.audio via HuggingFace) ---
# Get a token at https://huggingface.co/settings/tokens and accept the model licenses:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/embedding
HF_TOKEN=

# --- Backing services ---
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# --- Backend server ---
MEETING_COPILOT_HOST=127.0.0.1
MEETING_COPILOT_PORT=8765
